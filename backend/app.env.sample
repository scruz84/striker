# Extra CORS origins beyond the built-in defaults (http://localhost:3000 and :5173 for the
# Docker/nginx and `npm run dev` frontends) - comma-separated. A deployment sets its public
# frontend origin here, e.g. https://striker.example.com. See common.CorsAllowedOrigins.
CORS_ALLOWED_ORIGINS=

# Set to "true" to let anyone sign in as one of common.DevUsers (one admin, a few plain users)
# with no credential check at all - no Google OAuth setup needed. NEVER set this on a real
# deployment. See common.DevLoginEnabled and the "Dev login" section of README.md.
DEV_LOGIN_ENABLED=false

# Comma-separated emails granted commissioner/admin access on login. See
# common.IsConfiguredAdminEmail.
ADMIN_EMAILS=

# Comma-separated country codes a fresh --initialize creates a world for, and that a new Google
# sign-in can be randomly assigned to - each must already be a known country (see
# common.KnownCountries, which lists what has the required name-pool/naming data). Leave blank
# for the default es,en,fr,de. See common.SeededCountries.
SEEDED_COUNTRIES=

DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=database
DB_USER=user
DB_PASSWORD=pwd

REDIS_HOST=host
REDIS_PORT=port
REDIS_DB=0

# Both must be >= 32 characters and not a placeholder (`openssl rand -base64 48`), or --svc
# refuses to start unless DEV_LOGIN_ENABLED=true.
SECRET_JWT=replace-with-openssl-rand-base64-48
SESSION_SECRET=replace-with-another-openssl-rand-base64-48
REALM=Striker Manager
COOKIE_DOMAIN=127.0.0.1

TOKEN_EXPIRED_IN=60m
TOKEN_MAX_AGE=60

# Required: Google ID tokens are validated against this audience (same value as the frontend).
GOOGLE_OAUTH_CLIENT_ID=XXXX
GOOGLE_OAUTH_CLIENT_SECRET=YYYY
GOOGLE_OAUTH_CREDENTIALS_FILE=configs/client_secret.json
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:1984/v1/sessions/oauth/google

# VAPID keypair identifying this server to browser push services (see common.ConfigureWebPushNotifier).
# Generate a pair with `go run github.com/SherClockHolmes/webpush-go/cmd/webpush-gen-vapid-keys@latest`
# or webpush.GenerateVAPIDKeys(). Leave both blank to fall back to log-only notifications (no real
# push sent) - fine for local dev without a keypair of your own. VAPID_PUBLIC_KEY must also be set
# as VITE_VAPID_PUBLIC_KEY (see frontend/.env.development.local.sample) or VAPID_PUBLIC_KEY (see
# set-env.sh) for a deployed build, since the browser needs it too to create a subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
