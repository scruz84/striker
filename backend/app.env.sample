# Extra CORS origins beyond the built-in defaults (the two deployed domains, plus
# http://localhost:3000 and :5173 for the Docker/nginx and `npm run dev` frontends) - comma-
# separated, only needed for a non-default port or a staging domain. See common.CorsAllowedOrigins.
CORS_ALLOWED_ORIGINS=

DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=database
DB_USER=user
DB_PASSWORD=pwd

REDIS_HOST=host
REDIS_PORT=port
REDIS_DB=0

SECRET_JWT=my-secret
SESSION_SECRET=my-session-secret
REALM=Striker Manager
COOKIE_DOMAIN=127.0.0.1

TOKEN_EXPIRED_IN=60m
TOKEN_MAX_AGE=60

GOOGLE_OAUTH_CLIENT_ID=XXXX
GOOGLE_OAUTH_CLIENT_SECRET=YYYY
GOOGLE_OAUTH_CREDENTIALS_FILE=configs/client_secret.json
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:1984/v1/sessions/oauth/google
