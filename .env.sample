# Settings for the root docker-compose.yml. Copy to .env (never commit .env) and edit:
#   cp .env.sample .env
# Every variable is optional unless marked "Required"; an unset one uses the default shown.
# HOWTO_RUN.md explains each group in more detail.

# --- Images ----------------------------------------------------------------------------------
# Which published images to run: latest, or sha-<commit> to pin an exact build (the tags are
# listed under the repository's Packages on GitHub). `docker compose up --build` builds from the
# checkout instead and ignores the registry.
STRIKER_TAG=latest

# --- Bundled or external Postgres/Redis -----------------------------------------------------
# Which bundled services to start. Remove `postgres` and/or `redis` to use one that already runs
# elsewhere, and point DB_* / REDIS_* below at it.
COMPOSE_PROFILES=postgres,redis

# Postgres. With the bundled container, these also create its database and user on first start.
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=striker
DB_USER=striker
DB_PASSWORD=striker
# Volume of the bundled Postgres. Set it to striker-backend_postgres-data to keep the data of a
# database created by the old backend/docker-compose.yml.
#POSTGRES_VOLUME=striker_postgres-data

# Redis.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Security -------------------------------------------------------------------------------
# Required (unless DEV_LOGIN_ENABLED=true): two different random values of at least 32
# characters, e.g. `openssl rand -base64 48`. The API refuses to start with these placeholders.
SECRET_JWT=dev-only-change-me
SESSION_SECRET=dev-only-change-me
# Required (unless DEV_LOGIN_ENABLED=true): Google OAuth client id, used by both the API (to
# validate sign-ins) and the frontend (to start them).
GOOGLE_OAUTH_CLIENT_ID=
# Local development only: lets anyone sign in as a fixed set of dev users, admin included, with no
# credential check. NEVER enable it on a deployment reachable by anyone else.
DEV_LOGIN_ENABLED=false
# Comma-separated emails granted admin access on login.
ADMIN_EMAILS=
# Extra allowed browser origins beyond http://localhost:3000 and :5173, comma-separated - set your
# public frontend origin here, e.g. https://striker.example.com.
CORS_ALLOWED_ORIGINS=
REALM=Striker Manager
SESSION_TIMEOUT=24h

# --- Game -----------------------------------------------------------------------------------
# Countries a fresh world is seeded with (`init`), comma-separated. Blank = es,en,fr,de.
SEEDED_COUNTRIES=

# --- Web push -------------------------------------------------------------------------------
# VAPID keypair for browser push notifications. Blank = notifications are only logged. Generate
# a pair with `go run github.com/SherClockHolmes/webpush-go/cmd/webpush-gen-vapid-keys@latest`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Frontend -------------------------------------------------------------------------------
# The API's address as the user's browser reaches it (the browser calls it directly).
API_URI=http://localhost:1984
# Who runs this deployment, shown in the Privacy Policy, Terms and legal notice. Name and contact
# email are required for a public deployment.
LEGAL_CONTROLLER_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_CONTROLLER_TAX_ID=
LEGAL_POSTAL_ADDRESS=
LEGAL_HOSTING_PROVIDER=
LEGAL_HOSTING_REGION=
# true publishes the "Aviso legal" page (needs name, tax id and address).
LEGAL_NOTICE_ENABLED=

# --- Ports on the host ----------------------------------------------------------------------
SVC_PORT=1984
FRONTEND_PORT=3000
# The bundled Postgres/Redis are published on 127.0.0.1 only.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# --- Metrics --------------------------------------------------------------------------------
# OpenTelemetry metrics export (see backend/README.md, "OpenTelemetry metrics").
OTEL_METRICS_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
